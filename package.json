{
  "name": "stephen-fde-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,VLM,TSP,WEB -c cyan,magenta,yellow,green \"npm:dev:server\" \"npm:dev:vlm\" \"npm:dev:tsp\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "dev:vlm": "ai-vlm/backend/.venv/bin/python -m uvicorn app.main:app --app-dir ai-vlm/backend --host 0.0.0.0 --port 8001 --reload",
    "dev:tsp": "ai-tsp/backend/.venv/bin/python -m uvicorn app.main:app --app-dir ai-tsp/backend --host 0.0.0.0 --port 8002 --reload",
    "vlm:install": "python3 -m venv ai-vlm/backend/.venv && ai-vlm/backend/.venv/bin/pip install -r ai-vlm/backend/requirements.txt",
    "vlm:test": "PYTHONPATH=ai-vlm/backend ai-vlm/backend/.venv/bin/python -m pytest ai-vlm/backend/tests",
    "tsp:install": "python3 -m venv ai-tsp/backend/.venv && ai-tsp/backend/.venv/bin/pip install -r ai-tsp/backend/requirements.txt",
    "tsp:test": "PYTHONPATH=ai-tsp/backend ai-tsp/backend/.venv/bin/python -m pytest ai-tsp/backend/tests",
    "build": "vue-tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "concurrently -k -n API,VLM,TSP -c cyan,magenta,yellow \"npm:start:server\" \"npm:start:vlm\" \"npm:start:tsp\"",
    "start:server": "node dist-server/index.js",
    "start:vlm": "ai-vlm/backend/.venv/bin/python -m uvicorn app.main:app --app-dir ai-vlm/backend --host 0.0.0.0 --port 8001",
    "start:tsp": "ai-tsp/backend/.venv/bin/python -m uvicorn app.main:app --app-dir ai-tsp/backend --host 0.0.0.0 --port 8002"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.4.1",
    "cors": "^2.8.5",
    "echarts": "^6.0.0",
    "element-plus": "^2.11.5",
    "express": "^5.1.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.7.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^7.1.9",
    "vue-tsc": "^3.1.1"
  }
}
