# 数据库配置
# 数据库引擎，可选值：mysql
# 配置时将文件重命名为.env
VOLCENGINE_RDS_ENGINE=
VOLCENGINE_RDS_HOST=
VOLCENGINE_RDS_PORT=3306
VOLCENGINE_RDS_DATABASE=fde-database
VOLCENGINE_RDS_USERNAME=
VOLCENGINE_RDS_PASSWORD=
VOLCENGINE_RDS_SSL_MODE=
TOS_ACCESS_KEY=
TOS_SECRET_KEY=
# Ark model endpoint and API key placeholders for local debugging.
MODEL_AGENT_NAME=
MODEL_AGENT_API_KEY=

MODEL_AGENT_BASE_URL=

# Optional Volcengine credentials for local AgentKit/VeADK debugging.
VOLCENGINE_ACCESS_KEY=
VOLCENGINE_SECRET_KEY=