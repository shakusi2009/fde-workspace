{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "VLM Backend: Debug",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/ai-vlm/backend/.venv/bin/python",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--app-dir",
        "ai-vlm/backend",
        "--host",
        "0.0.0.0",
        "--port",
        "8001"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true
    }
  ]
}
